# Mirror of src/lumid_data/server/config.py.

# Server
LUMID_DATA_HTTP_PORT=9100
LUMID_DATA_BASE_URL=http://lumid-data:9100
LOG_LEVEL=INFO

# Postgres
DATABASE_URL=postgresql+psycopg://app_admin:app_admin@postgres:5432/lumid_data

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=lumid_data
S3_SECRET_KEY=lumid_data_secret_change_me
S3_REGION=us-east-1
S3_DEFAULT_BUCKET=lumid-data

# PostgREST sidecar
POSTGREST_URL=http://postgrest:3000
POSTGREST_JWT_SECRET=change-me-to-a-32-byte-random-string
POSTGREST_JWT_TTL_SEC=60
POSTGREST_USER_PASSWORD=app_admin
POSTGREST_ANON_ROLE=postgrest_anon
POSTGREST_USER_ROLE=app_user
POSTGREST_ADMIN_ROLE=app_admin

# NATS (optional — enables audit fan-out on lumid.data.audit.{op})
NATS_URL=

# Kafka bootstrap (optional — required only for kafka-transport streams)
KAFKA_BOOTSTRAP=redpanda:9092

# LLM provider — anthropic | openai | openai_compat
LUMID_DATA_LLM_PROVIDER=anthropic
LUMID_DATA_LLM_MODEL=claude-sonnet-4-6
LUMID_DATA_LLM_API_KEY=
LUMID_DATA_LLM_BASE_URL=
LUMID_DATA_AGENT_MAX_STEPS=20

# Plugin loader (CSV of importable module names; identity providers, etc.)
LUMID_DATA_PLUGINS=
