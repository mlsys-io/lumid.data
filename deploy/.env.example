# Generated by scripts/dev/check_env_examples.py — do not edit by hand.
# Mirror of the canonical schema in src/lumid_data/server/config.py.

# Server
LUMID_DATA_HTTP_PORT=9100
LOG_LEVEL=INFO

# Postgres (data plane operational DB)
DATABASE_URL=postgresql+psycopg://lumid_data:lumid_data@postgres:5432/lumid_data

# MinIO (S3-compatible object store)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=lumid_data
S3_SECRET_KEY=lumid_data_secret_change_me
S3_BUCKET=lumid-data
S3_REGION=us-east-1

# Unity Catalog (catalog of record)
UC_BASE_URL=http://unity-catalog:8080
UC_TOKEN=
UC_CATALOG=lumid_data

# NATS (DatasetReady / lineage events)
NATS_URL=nats://nats:4222

# FlowMesh trace upload (post-PR mlsys-io/FlowMesh#3). Optional — only
# used when ingest happens within a workflow context that has a
# task_id; left unset for un-attributed ingest. Cross-service "I made a
# new dataset" notification is via NATS DatasetReady, not this endpoint.
FLOWMESH_TRACES_URL=
FLOWMESH_TRACES_TOKEN=

# Plugin loader (CSV of importable module names)
LUMID_DATA_PLUGINS=

# Lumid OAuth (used by the lumid plugin when LUMID_DATA_PLUGINS includes it)
LUMID_OAUTH_INTROSPECT_URL=https://lum.id/oauth/introspect

# Streaming (Phase 2). Default-on for one-click; flip to `false` to skip
# Redpanda + RisingWave provisioning at app startup.
LUMID_DATA_STREAMING_ENABLED=true
REDPANDA_BROKERS=redpanda:9092
RISINGWAVE_DSN=postgresql://root@risingwave:4566/dev

# Vectors profile (Phase 3)
MILVUS_URI=http://milvus:19530

# Timeseries profile (Phase 3)
TIMESCALE_URL=postgresql+psycopg://timescale:timescale@timescaledb:5432/timescale
